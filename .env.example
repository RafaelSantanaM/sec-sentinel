# Ambiente: development | staging | production
ENVIRONMENT=development
PROJECT_NAME=SecSentinel
DEBUG=false

# Segurança: Gere com `openssl rand -hex 32` (Mínimo 32 caracteres e alta entropia exigidos!)
JWT_SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Banco de Dados Assíncrono (asyncpg)
POSTGRES_USER=secsentinel_user
POSTGRES_PASSWORD=local_dev_strong_password_123
POSTGRES_DB=secsentinel_db
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Fila e Cache (Redis)
REDIS_URL=redis://127.0.0.1:6379/0
